		annotation SummarizationSetBy = Automatic

	column Channel
		dataType: string
		lineageTag: ed20e4af-2e6a-467a-965c-f2ccac362be6
		summarizeBy: none
		sourceColumn: Channel

		annotation SummarizationSetBy = Automatic

	column IsDelivered
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 58ca9213-28b0-414b-99ae-4e2693657dce
		summarizeBy: none
		sourceColumn: IsDelivered

		annotation SummarizationSetBy = Automatic

	/// True for orders not yet due. EXCLUDE from OTIF: an order that is not due can be neither on time nor late.
	column IsOpenOrder
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 3d585345-6eaa-47a2-a8be-90c0d9d8132f
		summarizeBy: none
		sourceColumn: IsOpenOrder

		annotation SummarizationSetBy = Automatic

	/// Actual minus promised, in days. Positive means late. NULL while open.
	column DeliveryDelayDays
		dataType: int64
		formatString: 0
		lineageTag: 0563d4f7-bfec-44dd-aee9-0bc955bc18cb
		summarizeBy: none
		sourceColumn: DeliveryDelayDays

		annotation SummarizationSetBy = Automatic

