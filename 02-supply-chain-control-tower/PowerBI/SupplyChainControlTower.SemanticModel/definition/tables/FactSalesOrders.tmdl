	column Revenue
		dataType: double
		formatString: #,0.00
		lineageTag: 7cc0738e-2515-47e1-8659-ebca39baf0a9
		summarizeBy: sum
		sourceColumn: Revenue

		annotation SummarizationSetBy = Automatic

	column PromisedDeliveryDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: a4b0f493-52d4-4df8-8656-15df71dbdc99
		summarizeBy: none
		sourceColumn: PromisedDeliveryDate

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// NULL while the order is open. Populated only for the 79,565 orders delivered on or before the as-of date.
	column ActualDeliveryDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 58dfbaa4-be30-476e-9622-ee9a3cc95ffb
		summarizeBy: none
		sourceColumn: ActualDeliveryDate

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// NULL once delivered. Populated only for the 435 orders still in flight - an expectation, not a fact.
	column ScheduledDeliveryDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: aa6ef44f-ce35-4489-84b6-885f284e0119
		summarizeBy: none
		sourceColumn: ScheduledDeliveryDate

