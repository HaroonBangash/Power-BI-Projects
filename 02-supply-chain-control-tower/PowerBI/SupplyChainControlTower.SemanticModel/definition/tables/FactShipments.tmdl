/// Grain: one row per shipment. 80,000 rows. Active date is ShipDate. ProductID is resolved from the sales order in the SQL view, so no fact-to-fact relationship is needed.
table FactShipments
	lineageTag: 463cb4ba-78c0-4105-b47f-43cc2f441601

	column ShipmentID
		dataType: string
		lineageTag: 24631a5a-8917-4cbd-85bb-0c4e06d8279c
		summarizeBy: none
		sourceColumn: ShipmentID

		annotation SummarizationSetBy = Automatic

	/// Degenerate identifier. Deliberately NOT related to FactSalesOrders - a fact-to-fact relationship would break the star schema.
	column SalesOrderID
		dataType: string
		lineageTag: b2338700-e9cd-4790-8833-695daab00cee
		summarizeBy: none
		sourceColumn: SalesOrderID

		annotation SummarizationSetBy = Automatic

