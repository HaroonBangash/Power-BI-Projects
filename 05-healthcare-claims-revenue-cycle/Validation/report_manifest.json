  },
  {
    "name": "f88ed9cd74291f552c40",
    "visualType": "funnel",
    "title": "Billed to allowed to collected",
    "demonstrates": "funnel: nobody ever pays the chargemaster price. 26.5% of billed is a discount agreed before the claim was sent, and it is not a loss"
  },
  {
    "name": "fa36658b213a562d59b6",
    "visualType": "hundredPercentStackedColumnChart",
    "title": "What happened to each month's allowed amount",
    "demonstrates": "the composition is stable month after month, which is itself the finding: the share that never resolves does not improve with age"
  },
  {
    "name": "d2aacdede9bb3b4db2d2",
    "visualType": "clusteredColumnChart",
    "title": "Allowed and collected by payer",
    "demonstrates": "six payers, near-identical shares. The allowed RATE is 73.4% to 73.6% for every one of them, so no payer is ranked by contract performance anywhere in this report"
  },
  {
    "name": "797b263953ccbf960e71",
    "visualType": "clusteredColumnChart",
    "title": "Net collection rate by facility type",
    "demonstrates": "flat across all four types, to within half a point"
  },
  {
    "name": "66e5530a6649b4de3768",
    "visualType": "gauge",
    "title": "Net collection rate against a 95% benchmark",
    "demonstrates": "gauge, scaled 0 to 100% with the benchmark as its target. Without an explicit maximum a gauge scales to twice its own value, which puts any number in the middle of the dial"
  },
