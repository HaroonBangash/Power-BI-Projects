{
  "name": "Northstar Console",
  "dataColors": [
    "#37C9A8",
    "#6AA9E0",
    "#F2B441",
    "#E8657A",
    "#B78BE8",
    "#4FB3C4",
    "#8FD14F",
    "#E8944B",
    "#C98A7A",
    "#8FA9AD"
  ],
  "foreground": "#E6F1F2",
  "foregroundNeutralSecondary": "#8FA9AD",
  "foregroundNeutralTertiary": "#5B767C",
  "background": "#10292F",
  "backgroundLight": "#0E242A",
  "backgroundNeutral": "#1C3D45",
  "tableAccent": "#37C9A8",
  "good": "#37C9A8",
  "neutral": "#6AA9E0",
  "bad": "#E8657A",
  "maximum": "#E8657A",
  "center": "#F2B441",
  "minimum": "#37C9A8",
  "null": "#5B767C",
  "hyperlink": "#37C9A8",
  "visitedHyperlink": "#4FB3C4",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Consolas",
      "color": "#E6F1F2"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#E6F1F2"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#E6F1F2"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#8FA9AD"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#10292F"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1C3D45"
              }
            },
            "radius": 8,
            "width": 1
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6F1F2"
              }
            },
            "titleWrap": true
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#8FA9AD"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#8FA9AD"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#17343B"
              }
            },
            "gridlineStyle": "dotted",
            "showAxisTitle": true,
            "concatenateLabels": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#8FA9AD"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#8FA9AD"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#17343B"
              }
            },
            "gridlineStyle": "dotted",
            "showAxisTitle": true
          }
        ],
        "y2Axis": [
          {
            "labelColor": {
              "solid": {
                "color": "#8FA9AD"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#8FA9AD"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#8FA9AD"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#E6F1F2"
              }
            }
          }
        ],
        "wordWrap": [
          {
            "show": true
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#0A1D22"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#E6F1F2"
              }
            },
            "transparency": 0,
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#1C3D45"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "transparency": 0,
            "backgroundColor": {
              "solid": {
                "color": "#10292F"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#E6F1F2"
              }
            },
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#1C3D45"
              }
            }
          },
          {
            "$id": "Available",
            "transparency": 0,
            "backgroundColor": {
              "solid": {
                "color": "#10292F"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#E6F1F2"
              }
            },
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#1C3D45"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0A1D22"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0A1D22"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#9FC3C6"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0E242A"
              }
            },
            "columnAdjustment": "growToFit"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#E6F1F2"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#10292F"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E6F1F2"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#0E242A"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6F1F2"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0E242A"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#17343B"
              }
            },
            "gridVerticalColor": {
              "solid": {
                "color": "#17343B"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#1C3D45"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#9FC3C6"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0E242A"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6F1F2"
              }
            },
            "backColor": {
              "solid": {
                "color": "#10292F"
              }
            },
            "showExpandCollapseButtons": true,
            "legacyStyleDisabled": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#E6F1F2"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#10292F"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E6F1F2"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#0E242A"
              }
            }
          }
        ],
        "subTotals": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6F1F2"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0E242A"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6F1F2"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0E242A"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#17343B"
              }
            },
            "gridVerticalColor": {
              "solid": {
                "color": "#17343B"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#1C3D45"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6F1F2"
              }
            },
            "background": {
              "solid": {
                "color": "#0E242A"
              }
            },
            "padding": 4
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#8FA9AD"
              }
            }
          }
        ]
      }
    },
    "advancedSlicerVisual": {
      "*": {
        "value": [
          {
            "$id": "default",
            "fontColor": {
              "solid": {
                "color": "#E6F1F2"
              }
            }
          }
        ],
        "shapeCustomRectangle": [
          {
            "$id": "default",
            "tileShape": "rectangleRoundedByPixel",
            "rectangleRoundedCurve": 6
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}