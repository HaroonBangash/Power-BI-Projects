        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What this report assumes",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#37C9A8",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "As-of date. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#E6F1F2",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "3 Nov 2026, the last payment in the file. Nothing is projected past it.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#E6F1F2"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "AR is carried at ALLOWED. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#E6F1F2",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Billed would overstate the receivable by the 26.5% contractual adjustment.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#E6F1F2"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Patient responsibility leaves AR on the payer's payment date. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#E6F1F2",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "The source records no patient payment events. In reality this would begin a second, slower AR.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#E6F1F2"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Timely filing = 365 days. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#E6F1F2",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Used to mark receivables that could not be collected in practice. An assumption, not a fact in the data.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#E6F1F2"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Currency is AUD. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#E6F1F2",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Every facility state is Australian and the payers are Medicare, Bupa, Medibank, HCF and NIB.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#E6F1F2"
                    }
                  }
