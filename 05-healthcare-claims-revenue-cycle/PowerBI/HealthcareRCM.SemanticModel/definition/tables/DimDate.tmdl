		formatString: 0
		lineageTag: 824d3163-6569-5b57-b08a-2f417e89ad4e
		summarizeBy: none
		sourceColumn: MonthNo

		annotation SummarizationSetBy = Automatic

	column MonthName
		dataType: string
		lineageTag: d23e50d2-c3da-5ed3-8e4a-0813bd4f7724
		summarizeBy: none
		sourceColumn: MonthName
		sortByColumn: MonthNo

		annotation SummarizationSetBy = Automatic

	/// Three-letter month, for a narrow axis.
	column MonthShort
		dataType: string
		lineageTag: d065dedf-e79d-58b7-bacb-01538e5a7e4e
		summarizeBy: none
		sourceColumn: MonthShort
		sortByColumn: MonthNo

		annotation SummarizationSetBy = Automatic

	/// yyyymm. Sort key for MonthLabel.
	column MonthKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b9005b11-f59b-52a0-93c6-032fa954cda3
		summarizeBy: none
		sourceColumn: MonthKey

		annotation SummarizationSetBy = Automatic

	/// First day of the month.
	column MonthStart
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: cc408b65-b81b-5836-8811-332de0e05660
		summarizeBy: none
		sourceColumn: MonthStart

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// The AR snapshot lands on this date.
	column MonthEnd
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 88668179-bf7b-5ef0-947a-51c95ccb0387
		summarizeBy: none
		sourceColumn: MonthEnd

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

