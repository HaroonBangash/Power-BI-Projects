	/// FALSE for the days this build had to add because the supplied calendar stopped at the last service date. Kept so the gap is visible in the data rather than silently patched.
	column InSuppliedCalendar
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
