	/// Months from the as-of month: 0 = November 2026, so -11 to 0 is the trailing twelve months. A measure filters this integer instead of rebuilding a date range.
	column MonthOffset
		dataType: int64
		formatString: 0
		lineageTag: 8b6dd2bf-8bae-52e7-9681-1c0488c123de
