/// The calendar, GENERATED in SQL rather than loaded. The supplied dim_date.csv was built to the service date range and stops on 2026-08-31, but a claim is submitted after it is performed, adjudicated after that and paid after that - 4,807 dates fall past the end of it and would have joined to a blank date. This one runs 2022-01-01 to 2026-12-31 with no gaps. Marked as the date table. The financial year is Australian: July to June, labelled by the year it ends in.
table DimDate
	lineageTag: 19254668-3e75-516c-af89-c7bc3f51f65e
	dataCategory: Time

	/// yyyymmdd. The join key every fact uses.
	column DateKey
		dataType: int64
		isHidden
		lineageTag: 0bad55d1-5967-5d73-8ffc-31a88173dae7
		summarizeBy: none
		sourceColumn: DateKey

		annotation SummarizationSetBy = Automatic

	/// The model date. Unique and contiguous.
	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 1d24a5e5-ba05-59b3-bb61-780fe7ee5153
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 4a9005fc-e2ba-55bd-a08b-c41f2901994a
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	column MonthNo
