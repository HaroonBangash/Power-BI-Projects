model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["SqlServer","SqlDatabase","DimDate","DimCustomer","DimPlan","DimSeverity","DimMovementType","DimTenureBand","DimCohort","DimTenureMonth","FactSubscription","FactSubscriptionMonth","FactMRRMovement","FactInvoice","FactUsageMonthly","FactSupportTicket","FactAcquisition","ChurnDriverStrength","DataQualityMetric","ModelConfig","SecurityUserAccess","_Measures","Time Comparison","Customer Cut"]

ref table DimDate
ref table DimCustomer
ref table DimPlan
ref table DimSeverity
ref table DimMovementType
ref table DimTenureBand
ref table DimCohort
ref table DimTenureMonth
ref table FactSubscription
ref table FactSubscriptionMonth
ref table FactMRRMovement
ref table FactInvoice
ref table FactUsageMonthly
ref table FactSupportTicket
ref table FactAcquisition
ref table ChurnDriverStrength
ref table DataQualityMetric
ref table ModelConfig
ref table SecurityUserAccess
ref table _Measures
ref table 'Time Comparison'
ref table 'Customer Cut'

ref role 'Country Access'

ref cultureInfo en-US

