/// One customer's product usage in one month - for the customers it covers. Usage reaches about 40% of paying customers in any month, so everything here is a SAMPLE and is labelled as one. None of it predicts churn.
table FactUsageMonthly
	lineageTag: 7cbe54df-554a-5086-990a-bf251fd9a2cd

	column MonthStart
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: ca2f2dd2-e403-5a71-bb4f-1caada28f7b8
		summarizeBy: none
		sourceColumn: MonthStart

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column CustomerID
		dataType: string
		isHidden
		lineageTag: f51854d9-971b-5e2c-bd24-deedf6d0b02c
		summarizeBy: none
		sourceColumn: CustomerID

		annotation SummarizationSetBy = Automatic

	column LicensedSeats
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 45452421-9edc-506e-bf53-3344e96b2c7f
		summarizeBy: sum
		sourceColumn: LicensedSeats

		annotation SummarizationSetBy = Automatic

	column ActiveUsers
