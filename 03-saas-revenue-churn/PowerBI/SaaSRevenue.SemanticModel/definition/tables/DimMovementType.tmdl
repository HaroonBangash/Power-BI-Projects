		sourceColumn: MovementType
		sortByColumn: MovementOrder

		annotation SummarizationSetBy = Automatic

	column MovementOrder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 80e0c193-66d8-5eda-965c-0adf4284bde5
		summarizeBy: none
		sourceColumn: MovementOrder

		annotation SummarizationSetBy = Automatic

	/// +1 adds to MRR, -1 removes.
	column MovementSign
		dataType: int64
		isHidden
