		summarizeBy: sum
		sourceColumn: ARR

		annotation SummarizationSetBy = Automatic

	/// Carried by the view. NOT the filter path - slice DimCustomer[BillingCycle] instead.
	column BillingCycle
		dataType: string
		lineageTag: dc5f9b38-402d-5bc6-b244-1ea860d948ac
		summarizeBy: none
		sourceColumn: BillingCycle

		annotation SummarizationSetBy = Automatic

	/// Completed months to the end date, or to the as-of date while still running.
	column TenureMonths
		dataType: int64
