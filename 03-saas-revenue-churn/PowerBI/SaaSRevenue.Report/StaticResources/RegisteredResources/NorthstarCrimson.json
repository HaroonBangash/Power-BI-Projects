        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F7E4E8"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#8A5560"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FBF6F7"
              }
            },
            "columnAdjustment": "growToFit"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1C1B1D"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1C1B1D"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FBF6F7"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#1C1B1D"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FBF6F7"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#EFE6E8"
              }
            },
            "gridVerticalColor": {
              "solid": {
                "color": "#EFE6E8"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#E4D6D9"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#8A5560"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FBF6F7"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1C1B1D"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "showExpandCollapseButtons": true,
            "legacyStyleDisabled": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1C1B1D"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1C1B1D"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FBF6F7"
              }
            }
          }
        ],
        "subTotals": [
          {
            "fontColor": {
              "solid": {
                "color": "#1C1B1D"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FBF6F7"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#1C1B1D"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FBF6F7"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#EFE6E8"
              }
            },
            "gridVerticalColor": {
              "solid": {
                "color": "#EFE6E8"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#E4D6D9"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1C1B1D"
              }
            },
            "background": {
              "solid": {
                "color": "#FBF6F7"
              }
            },
            "padding": 4
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#6E686B"
              }
            }
          }
        ]
      }
    },
    "advancedSlicerVisual": {
      "*": {
        "value": [
          {
            "$id": "default",
            "fontColor": {
              "solid": {
                "color": "#1C1B1D"
              }
            }
          }
        ],
        "shapeCustomRectangle": [
          {
            "$id": "default",
            "tileShape": "rectangleRoundedByPixel",
            "rectangleRoundedCurve": 6
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}