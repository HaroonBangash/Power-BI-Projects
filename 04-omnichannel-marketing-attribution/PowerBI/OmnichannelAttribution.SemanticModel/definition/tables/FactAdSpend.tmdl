		sourceColumn: SpendUSD

		annotation SummarizationSetBy = Automatic

	/// Spend dated before the campaign's recorded StartDate.
	column IsBeforeCampaignStart
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: b6816656-a302-51de-8b62-b23987949489
		summarizeBy: none
		sourceColumn: IsBeforeCampaignStart

