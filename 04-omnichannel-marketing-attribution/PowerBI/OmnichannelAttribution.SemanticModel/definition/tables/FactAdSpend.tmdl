		isHidden
		formatString: 0.0000
		lineageTag: fe8077cd-0c8a-5e8d-9554-f97e9ddd8292
		summarizeBy: none
		sourceColumn: FxRateToUSD

		annotation SummarizationSetBy = Automatic

	column SpendUSD
