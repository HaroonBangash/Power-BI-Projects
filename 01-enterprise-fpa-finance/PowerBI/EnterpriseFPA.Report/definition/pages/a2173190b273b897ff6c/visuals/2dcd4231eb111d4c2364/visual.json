                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#e7eaf0"
                    }
                  },
                  {
                    "value": "Remaining months at the trailing-twelve-month run rate, flexed by the driver set; illustrative assumptions, not source data.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#e7eaf0"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Security. ",
