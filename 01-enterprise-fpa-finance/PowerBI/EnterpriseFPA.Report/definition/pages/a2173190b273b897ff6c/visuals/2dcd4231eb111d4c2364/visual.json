                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The forecast is one version. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#e7eaf0"
                    }
                  },
                  {
                    "value": "Its Scenario column is a random label per line - filtering to 'Base' would drop 40% of the plan - so scenarios are modelled from stated drivers instead.",
