/// Conformed calendar 2022-01-01 to 2027-06-30, generated in SQL because the supplied calendar ends on the as-of date while receivables run to January 2027. Marked as the date table. The financial year runs July to June: FY26 = Jul 2025 - Jun 2026.
table DimDate
	lineageTag: d24c5bc2-00be-5aca-9559-642d4d9231c5
	dataCategory: Time

	/// Model date key: unique, contiguous, no gaps.
	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 6dc94a11-3704-59ee-b377-3adcb7853285
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

