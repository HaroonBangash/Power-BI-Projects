model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AU
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["ProjectFolder","Raw_RetailSales","Stg_RetailSales","Src_ClusterAssignments","DimDate","DimTime","DimBranch","DimProduct","DimCustomer","DimPayment","DimCluster","FactSales","ClusterEvaluation"]

annotation PBI_ProTooling = ["DevMode"]

ref table FactSales
ref table DimDate
ref table DimTime
ref table DimBranch
ref table DimProduct
ref table DimCustomer
ref table DimPayment
ref table DimCluster
ref table ClusterEvaluation
ref table 'Key Measures'

ref cultureInfo en-US

